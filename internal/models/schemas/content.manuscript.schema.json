{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manuscript content",
  "description": "The text of one scene, as the manuscript exports it: blocks in reading order.",
  "type": "object",
  "required": ["blocks"],
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "block.schema.json" }
    }
  }
}
