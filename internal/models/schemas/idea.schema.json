{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "genre", "seed"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "genre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "\\S"
    }
  }
}
