{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "metadata", "data"],
        "properties": {
          "type": {
            "const": "text"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "marks"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768,
                "pattern": "\\S"
              },
              "marks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "start", "end"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["bold", "italic", "underline", "strikethrough"]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32768
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32768
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
