{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suggest output",
  "description": "What the model returns for a suggest generation: one suggestion per target of the task, in one list per target shape.",
  "type": "object",
  "required": ["manuscript", "text"],
  "additionalProperties": false,
  "properties": {
    "manuscript": {
      "type": "array",
      "description": "One suggestion per manuscript target, in any order.",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/edits" }
    },
    "text": {
      "type": "array",
      "description": "One suggestion per text target, in any order.",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "textTarget": {
      "type": "string",
      "description": "The handle of the text target the suggestion is for, such as T1.",
      "pattern": "^T[0-9]+$"
    },
    "manuscriptTarget": {
      "type": "string",
      "description": "The handle of the manuscript target the suggestion is for, such as M1.",
      "pattern": "^M[0-9]+$"
    },
    "note": {
      "type": "string",
      "description": "One line for the author on what the suggestion changes, in the project's language.",
      "maxLength": 300
    },
    "blockHandle": {
      "type": "string",
      "description": "The handle of a block inside the target's range, such as B3.",
      "pattern": "^B[0-9]+$"
    },
    "blocks": {
      "type": "array",
      "description": "New blocks, in reading order.",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/block" }
    },
    "block": {
      "description": "One unit of a scene's manuscript text, in reading order: a narration or a line of dialogue.",
      "oneOf": [{ "$ref": "#/$defs/block-narration" }, { "$ref": "#/$defs/block-dialogue" }]
    },
    "block-narration": {
      "type": "object",
      "description": "Prose the narrator tells: action, description, a character's thoughts. It follows the manuscript's language, voice and tense.",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "const": "narration" },
        "text": {
          "type": "string",
          "description": "The prose, as plain text. Paragraphs are separated by a blank line.",
          "maxLength": 100000
        }
      }
    },
    "block-dialogue": {
      "type": "object",
      "description": "One character's spoken line: the words spoken, with tone cues where the delivery changes.",
      "required": ["kind", "speaker", "parts"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "const": "dialogue" },
        "speaker": {
          "type": "string",
          "description": "The character who speaks, by the name the story gives them.",
          "maxLength": 200
        },
        "parts": {
          "type": "array",
          "description": "The line in speaking order.",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/block-part" }
        }
      }
    },
    "block-part": {
      "oneOf": [
        {
          "type": "object",
          "description": "Words the speaker says, without quotation marks.",
          "required": ["text"],
          "additionalProperties": false,
          "properties": { "text": { "type": "string", "maxLength": 20000 } }
        },
        {
          "type": "object",
          "description": "How the speaker says the words that follow, such as \"whispering\" or \"with a bitter laugh\".",
          "required": ["tone"],
          "additionalProperties": false,
          "properties": { "tone": { "type": "string", "maxLength": 500 } }
        }
      ]
    },
    "text": {
      "type": "object",
      "description": "The new text of a text target: a scene's title or description, or a notes cell.",
      "required": ["target", "note", "text"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/textTarget" },
        "note": { "$ref": "#/$defs/note" },
        "text": { "type": "string", "description": "The text, in full.", "maxLength": 200000 }
      }
    },
    "edits": {
      "type": "object",
      "description": "The changes to a manuscript target. Handles name blocks as the task shows them, before any edit.",
      "required": ["target", "note", "edits"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/manuscriptTarget" },
        "note": { "$ref": "#/$defs/note" },
        "edits": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "anyOf": [{ "$ref": "#/$defs/replace" }, { "$ref": "#/$defs/insertAfter" }, { "$ref": "#/$defs/delete" }]
          }
        }
      }
    },
    "replace": {
      "type": "object",
      "description": "Replaces one block with new blocks.",
      "required": ["op", "block", "blocks"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "const": "replace" },
        "block": { "$ref": "#/$defs/blockHandle" },
        "blocks": { "$ref": "#/$defs/blocks" }
      }
    },
    "insertAfter": {
      "type": "object",
      "description": "Inserts new blocks after a block, or at the start of the range when block is null.",
      "required": ["op", "block", "blocks"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "const": "insert_after" },
        "block": { "anyOf": [{ "$ref": "#/$defs/blockHandle" }, { "type": "null" }] },
        "blocks": { "$ref": "#/$defs/blocks" }
      }
    },
    "delete": {
      "type": "object",
      "description": "Deletes one block.",
      "required": ["op", "block"],
      "additionalProperties": false,
      "properties": {
        "op": { "type": "string", "const": "delete" },
        "block": { "$ref": "#/$defs/blockHandle" }
      }
    }
  }
}
