ionalProperties":false,"description":"The changes to a manuscript target. Handles name blocks as the task shows them, before any edit.","properties":{"edits":{"items":{"anyOf":[{"$ref":"#/$defs/replace"},{"$ref":"#/$defs/insertAfter"},{"$ref":"#/$defs/delete"}]},"maxItems":10000,"type":"array"},"note":{"$ref":"#/$defs/note"},"target":{"$ref":"#/$defs/targetHandle"}},"required":["target","note","edits"],"type":"object"},"insertAfter":{"additionalProperties":false,"description":"Inserts new blocks after a block, or at the start of the range when block is null.","properties":{"block":{"anyOf":[{"$ref":"#/$defs/blockHandle"},{"type":"null"}]},"blocks":{"$ref":"#/$defs/blocks"},"op":{"enum":["insert_after"],"type":"string"}},"required":["op","block","blocks"],"type":"object"},"note":{"description":"One line for the author on what the suggestion changes, in the project's language.","type":"string"},"replace":{"additionalProperties":false,"description":"Replaces one block with new blocks.","properties":{"block":{"$ref":"#/$defs/blockHandle"},"blocks":{"$ref":"#/$defs/blocks"},"op":{"enum":["replace"],"type":"string"}},"required":["op","block","blocks"],"type":"object"},"targetHandle":{"description":"The handle of the target the suggestion is for, such as T1.","pattern":"^T[0-9]+$","type":"string"},"text":{"additionalProperties":false,"description":"The new text of a text target: a scene's title or description, or a notes cell.","properties":{"note":{"$ref":"#/$defs/note"},"target":{"$ref":"#/$defs/targetHandle"},"text":{"description":"The text, in full.","type":"string"}},"required":["target","note","text"],"type":"object"}},"additionalProperties":false,"description":"What the model returns for a suggest generation: one suggestion per target of the task.","properties":{"suggestions":{"description":"One suggestion per target, in any order.","items":{"anyOf":[{"$ref":"#/$defs/text"},{"$ref":"#/$defs/edits"}]},"maxItems":20,"type":"array"}},"required":["suggestions"],"type":"object"}

=== frame
<frame>
<project title="The Clear Hours" language="en">
<premise>In a seaside town, Mary waits for Paul, who left without a word. An unsigned letter revives their story.</premise>
</project>
<layers>
<layer handle="L1" kind="manuscript" name="Manuscript">The text of the novel.</layer>
<layer handle="L2" kind="notes" name="Characters">Who appears in the scene, and what we learn about each.</layer>
<layer handle="L3" kind="notes" name="Plot">What the scene moves forward.</layer>
</layers>
<beats>
<beat title="The Wait">
<description>Mary waits for a sign from Paul.</description>
<scene handle="S1" title="Opening">Mary waits for Paul in the rain, at the harbor café.</scene>
<scene handle="S2" title="The Letter">An unsigned letter arrives.</scene>
</beat>
<beat title="The Reunion">
<description>Mary and Paul meet again.</description>
<scene handle="S3" title="The Quay">Mary meets Paul at dawn.</scene>
<scene handle="S4">Paul tells of his two years away.</scene>
</beat>
<beat title="A Year On">
<description>What remains of the story.</description>
<scene handle="S5" title="Epilogue">A year later.</scene>
</beat>
</beats>
</frame>

=== neighborhood
<neighborhood>
<scene handle="S1" level="outline">
<cell layer="L2">Mary, a schoolteacher, thirty. She has waited for Paul for two years.</cell>
</scene>
<scene handle="S2" level="recap">
<recap layer="L1">An unsigned letter reaches Mary. She knows Paul's handwriting, and he asks to meet her on the quay at dawn.</recap>
<cell layer="L2">The postman, in a hurry.</cell>
</scene>
<scene handle="S3" level="full">
<beat-prompt>Keep the tone restrained, with no outpouring.</beat-prompt>
<prompt>Paul says little; Mary leads the exchange.</prompt>
<cell layer="L1" target="T1"/>
<cell layer="L2">Paul, back from Brest. Mary.</cell>
</scene>
<scene handle="S4" level="full">
<beat-prompt>Keep the tone restrained, with no outpouring.</beat-prompt>
<cell layer="L1">
<narration>They walked to the lighthouse in silence. Paul stopped at the rusted gate.

He told her about Brest, the shipyard, Captain Morel who took him under his wing, then the debt.</narration>
<dialogue speaker="Paul"><text>I couldn't write to you.</text><tone>after a silence</tone><text>Not before I had paid it all back.</text></dialogue>
</cell>
<cell layer="L2">Paul; Captain Morel, his former employer.</cell>
</scene>
<scene handle="S5" level="full">
<cell layer="L2">Mary alone on the quay, a letter in her hand.</cell>
<cell layer="L3" target="T3"/>
</scene>
</neighborhood>

=== task
<task>
<target handle="T1" scene="S3" layer="L1" mode="revise">
<before>
<narration>Dawn turned the harbor gray.</narration>
</before>
<range>
<dialogue handle="B1" speaker="Paul"><text>You got my letter.</text></dialogue>
<narration handle="B2" kept="true">Mary did not answer at once.</narration>
</range>
<after>
<dialogue speaker="Mary"><tone>curtly</tone><text>Two years, Paul.</text></dialogue>
</after>
</target>
<target handle="T2" scene="S4" field="title" mode="write"/>
<target handle="T3" scene="S5" layer="L3" mode="write"/>
<instruction>Make the scene tenser, without adding dialogue.</instruction>
<rules>Write one suggestion for each target. Change only the blocks inside a range, never a kept block. Write in English, without dialogue punctuation.</rules>
</task>
